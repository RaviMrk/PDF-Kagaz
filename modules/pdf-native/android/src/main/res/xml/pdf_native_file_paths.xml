<?xml version="1.0" encoding="utf-8"?>
<!--
  PdfNativeFileProvider exposes cache paths only: reader copies (cacheDir/reader) and share copies
  (cacheDir/share, see ShareFiles). Other file:// PDFs are copied into cacheDir/share before sharing.
  The provider is not exported: other apps only reach a URI this app granted.
-->
<paths>
  <cache-path name="reader" path="reader/" />
  <cache-path name="share" path="share/" />
</paths>
